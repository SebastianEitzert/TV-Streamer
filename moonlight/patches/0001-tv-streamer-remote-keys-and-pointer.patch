+                LiSendKeyboardEvent(0x8000 | VK_F17, event->state == SDL_PRESSED ? KEY_ACTION_DOWN : KEY_ACTION_UP, 0);
+            }
+            return true;
+#endif
 #if TV_REMOTE_TOGGLE_SOFT_INPUT
