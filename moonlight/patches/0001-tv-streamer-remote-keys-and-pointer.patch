diff --git a/src/app/platform/webos/keyboard_webos.c b/src/app/platform/webos/keyboard_webos.c
index 652545b..0200ac3 100644
--- a/src/app/platform/webos/keyboard_webos.c
+++ b/src/app/platform/webos/keyboard_webos.c
@@ -16,6 +16,126 @@
 #include "app_webos.h"
 
 #define TV_REMOTE_TOGGLE_SOFT_INPUT 0
+#ifndef TV_STREAMER_REMOTE_KEYS
+#define TV_STREAMER_REMOTE_KEYS 1
+#endif
+
+#if TV_STREAMER_REMOTE_KEYS
+/* TV Streamer: webOS hides the Magic Remote pointer on every arrow key (5-way mode) and only shows it again once the
+ * remote has been moved far enough – until then no pointer motion arrives and the host's mouse seems frozen. While
+ * streaming, ask for the pointer right away and a few more times shortly after (webOS may hide it a little later). */
+static Uint32 tvs_show_at[4];
+
+static void tvs_pointer_back(void) {
+    static const Uint32 after_ms[4] = {30, 100, 200, 350};
+    Uint32 now = SDL_GetTicks();
+    SDL_webOSCursorVisibility(SDL_TRUE);
+    for (int i = 0; i < 4; i++) {
+        tvs_show_at[i] = now + after_ms[i];
+    }
+}
+
+/* Measurement for the TV Streamer: marker keys the streamer page sees but ignores – F18 = webOS hid the pointer,
+ * F19 = webOS shows it again, F20 = first pointer motion after an arrow key. The streamer measures the times between
+ * them and the arrow key and reports them to Home Assistant. */
+static bool tvs_wait_motion = false;
+
+static void tvs_marker(short vk) {
+    LiSendKeyboardEvent(0x8000 | vk, KEY_ACTION_DOWN, 0);
+    LiSendKeyboardEvent(0x8000 | vk, KEY_ACTION_UP, 0);
+}
+
+/* Pointer from the Magic Remote's own service (TV Streamer, test): after an arrow key webOS sends no pointer motion
+ * for up to three seconds. The remote service (com.webos.service.mrcu) may keep reporting where the remote points;
+ * while no real motion has come since the arrow key, its changes move the host's mouse. Markers for the measurement:
+ * F21 = sensor data came after the arrow key, F22 = the service could not be called, F23 = it refused. */
+static volatile Uint32 tvs_freeze_until = 0;   /* sensor moves the mouse until then (or until real motion) */
+static volatile bool tvs_sensor_mark = false;  /* send F21 with the next sensor data */
+
+#if TVS_HAVE_HELPERS
+#include <libhelpers.h>
+#include <stdlib.h>
+#include <string.h>
+
+static bool tvs_sensor_started = false, tvs_sensor_refused = false;
+static bool tvs_have_last = false;
+static int tvs_last_x = 0, tvs_last_y = 0;
+
+static bool tvs_num(const char *s, const char *key, int *out) {
+    const char *p = strstr(s, key);
+    if (!p) return false;
+    p += strlen(key);
+    while (*p == ' ' || *p == ':' || *p == '"') p++;
+    char *end = NULL;
+    double v = strtod(p, &end);
+    if (end == p) return false;
+    *out = (int) v;
+    return true;
+}
+
+static bool tvs_sensor_cb(LSHandle *sh, LSMessage *reply, void *ctx) {
+    (void) sh; (void) ctx;
+    const char *msg = HLunaServiceMessage(reply);
+    if (!msg) return true;
+    if (strstr(msg, "\"returnValue\":false") || strstr(msg, "\"returnValue\": false")) {
+        if (!tvs_sensor_refused) { tvs_sensor_refused = true; tvs_marker(VK_F23); }
+        return true;
+    }
+    const char *c = strstr(msg, "\"coordinate\"");
+    int x, y;
+    if (!c || !tvs_num(c, "\"x\"", &x) || !tvs_num(c, "\"y\"", &y)) return true;
+    if (tvs_sensor_mark) { tvs_sensor_mark = false; tvs_marker(VK_F21); }
+    if (tvs_have_last && tvs_freeze_until && !SDL_TICKS_PASSED(SDL_GetTicks(), tvs_freeze_until)) {
+        int dx = x - tvs_last_x, dy = y - tvs_last_y;
+        if ((dx || dy) && dx > -400 && dx < 400 && dy > -400 && dy < 400) LiSendMouseMoveEvent((short) dx, (short) dy);
+    }
+    tvs_last_x = x; tvs_last_y = y; tvs_have_last = true;
+    return true;
+}
+
+/* sleep:false – the remote shall keep reporting its position (test 27.10.: with sleep:true the data paused for as long
+ * as webOS' own pointer motion, 1.0–1.7 s after an arrow key) */
+static void tvs_sensor_start(void) {
+    if (tvs_sensor_started) return;
+    tvs_sensor_started = true;
+    static union { HContext ctx; unsigned char placeholder[128]; } context;
+    memset(&context, 0, sizeof(context));
+    context.ctx.multiple = 1;
+    context.ctx.pub = 1;
+    context.ctx.callback = tvs_sensor_cb;
+    if (HLunaServiceCall("luna://com.webos.service.mrcu/sensor/getSensorData",
+                         "{\"callbackInterval\":1,\"subscribe\":true,\"sleep\":false,\"autoAlign\":false}",
+                         &context.ctx) != 0) {
+        tvs_marker(VK_F22);
+    }
+}
+#else
+static void tvs_sensor_start(void) {
+    static bool told = false;
+    if (!told) { told = true; tvs_marker(VK_F22); }  /* built without libhelpers: no sensor */
+}
+#endif
+
+/* Called for every pointer motion while streaming (session_mouse.c). */
+void stream_input_webos_motion_seen(void) {
+    tvs_freeze_until = 0;  /* real motion again: the sensor stops moving the mouse */
+    if (tvs_wait_motion) {
+        tvs_wait_motion = false;
+        tvs_marker(VK_F20);
+    }
+}
+
+/* Called from the main loop: the delayed requests of tvs_pointer_back(). */
+void stream_input_webos_pointer_tick(void) {
+    Uint32 now = SDL_GetTicks();
+    for (int i = 0; i < 4; i++) {
+        if (tvs_show_at[i] != 0 && SDL_TICKS_PASSED(now, tvs_show_at[i])) {
+            tvs_show_at[i] = 0;
+            SDL_webOSCursorVisibility(SDL_TRUE);
+        }
+    }
+}
+#endif
 
