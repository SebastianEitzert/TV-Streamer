diff --git a/src/app/lvgl/input/lv_drv_sdl_key.c b/src/app/lvgl/input/lv_drv_sdl_key.c
index 4039940..ae4db89 100644
--- a/src/app/lvgl/input/lv_drv_sdl_key.c
+++ b/src/app/lvgl/input/lv_drv_sdl_key.c
@@ -271,6 +271,15 @@ static void webos_key_input_mode(app_ui_input_t *input, const SDL_KeyboardEvent
         case SDLK_DOWN:
         case SDLK_LEFT:
         case SDLK_RIGHT: {
+            if (input->ui->app->session != NULL) {
+                /* TV Streamer: while streaming, the arrows go to the host and the Magic Remote pointer stays the
+                 * mouse. Show the pointer again as soon as the key is released, instead of waiting until the
+                 * remote is shaken. */
+                if (event->type == SDL_KEYUP) {
+                    SDL_webOSCursorVisibility(SDL_TRUE);
+                }
+                break;
+            }
             if (!SDL_IsScreenKeyboardShown(input->ui->window)) {
                 SDL_webOSCursorVisibility(SDL_FALSE);
             }
